# Copy to .env (git-ignored). Everything is optional - the app works without any of it.

# Enables the AI coach (Claude-written bullet rewrites + tailored summary).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# COACH_MODEL=claude-opus-5-5     # model used by the AI coach
# ANALYZE_PER_MINUTE=30           # analyses per IP per minute (0 = unlimited)
# COACH_PER_MINUTE=5              # AI coach calls per IP per minute
# TRUST_PROXY=false               # true behind Render/Railway/nginx so rate limits see real IPs
